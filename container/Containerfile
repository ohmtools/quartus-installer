FROM quay.io/toolbx/ubuntu-toolbox:24.04

LABEL org.opencontainers.image.source="https://github.com/ohmtools/quartus-installer"
LABEL org.opencontainers.image.description="Environment for simplifying the software installation and usage of \"Quartus Prime Lite\""

RUN <<EOF
set -e

apt-get update

# Locale
apt-get install -y --no-install-recommends locales=2.39-0ubuntu8.7
sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
sed -i -e 's/# de_DE.UTF-8 UTF-8/de_DE.UTF-8 UTF-8/' /etc/locale.gen
locale-gen

# Quartus
apt-get install -y --no-install-recommends \
  libxft2=2.3.6-1build1 \
  libsm6=2:1.2.3-1build3 \
  libfontconfig1=2.15.0-1.1ubuntu2 \
  libxext6=2:1.3.4-1build2

# Installer
apt-get install -y --no-install-recommends \
  zenity=4.0.1-1build3 \
  libnotify-bin=0.8.3-1build2 \
  python3-dbus=1.3.2-5build3 \
  python3-gi=3.48.2-1

apt-get clean
rm -rf /var/lib/apt/lists/*
EOF

ENV LANG=en_US.UTF-8

COPY bin /usr/local/bin
COPY etc /usr/local/etc
COPY lib /usr/local/lib
COPY share /usr/local/share
