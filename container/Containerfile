FROM quay.io/toolbx/ubuntu-toolbox:24.04

# Forgejo Next
LABEL org.opencontainers.image.source="https://codeberg.org/tobilinz/quartus-prime-lite-installer"
LABEL org.opencontainers.image.description="Quartus prime lite package for a semi-automated install"

RUN apt-get update \
    && apt-get install -y zenity libglib2.0-0t64 libxext6 libfontconfig1 libsm6 libxft2 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY quartus-install /usr/local/bin/quartus-install
COPY mime-install /usr/local/bin/quartus-mime-install
COPY uninstall /usr/local/bin/quartus-uninstall

RUN mkdir -p /etc/quartus
COPY quartus.desktop /etc/quartus/quartus.desktop
COPY quartus-bdf.xml /etc/quartus/quartus-bdf.xml

RUN mkdir -p /etc/profile.d/
COPY <<'EOF' /etc/profile.d/quartus-setup.sh
SHARE="$HOME/.local/share"

QUARTUS_DIR="$SHARE/quartus-prime-lite"
ICON_FILE="$QUARTUS_DIR/quartus/adm/quartusii.png"

DESKTOP_DIR="$SHARE/applications"
DESKTOP_FILE="$DESKTOP_DIR/quartus.desktop"
if [ ! -f "$DESKTOP_FILE" ]; then
    mkdir -p "$DESKTOP_DIR"
    cp /etc/quartus/quartus.desktop "$DESKTOP_FILE"
    sed -i "s|^Exec=.*|Exec=$QUARTUS_DIR/quartus/bin/quartus --64bit %f|" "$DESKTOP_FILE"
    sed -i "s|^Icon=.*|Icon=$ICON_FILE|" "$DESKTOP_FILE"
fi

MIME_DIR="$SHARE/mime/packages"
MIME_FILE="$MIME_DIR/quartus-bdf.xml"
if [ ! -f "$MIME_FILE" ]; then
    mkdir -p "$MIME_DIR"
    cp /etc/quartus/quartus-bdf.xml "$MIME_FILE"
fi

MIME_VARS_DIR="$HOME/.config"
MIME_VARS_FILE="$MIME_VARS_DIR/bdf-mime-vars"
mkdir -p "$MIME_VARS_DIR"
touch "$MIME_VARS_FILE"
echo -e "export ICON_FILE=$ICON_FILE\nexport MIME_FILE=$MIME_FILE" >"$MIME_VARS_FILE"

UNINSTALL_FILE="$HOME/uninstall"
if [ ! -f "$UNINSTALL_FILE" ]; then
    cp /usr/local/bin/quartus-uninstall "$UNINSTALL_FILE"
fi

MIME_INSTALL_FILE="$HOME/mime-install"
if [ ! -f "$MIME_INSTALL_FILE" ]; then
    cp /usr/local/bin/quartus-mime-install "$MIME_INSTALL_FILE"
fi

quartus-install
EOF
