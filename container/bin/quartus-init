set -euo pipefail

host_user="$(stat -c '%u' "$HOME")"
host_group="$(stat -c '%g' "$HOME")"

trap 'chown -R "$host_user:$host_group" "$HOME"' EXIT

source /usr/local/lib/dirs.bash

cp -f /usr/local/etc/host-scripts/* "$HOME"

# HOST_SHARE path used by HOST_ICON_FILE doesn't work here because host-run doesn't work in init scripts
HOST_ICON_FILE="$HOST_HOME/.local/share$HOST_ICON_FILE"
host_icon_file_dir="$(dirname "$HOST_ICON_FILE")"
mkdir -p "$host_icon_file_dir"
ln -sf "$QUARTUS_DIR/quartus/adm/quartusii.png" "$HOST_ICON_FILE"
chown -R "$host_user:$host_group" "$host_icon_file_dir"
