set -euo pipefail

host_user="$(stat -c '%u' "$HOME")"
host_group="$(stat -c '%g' "$HOME")"

trap 'chown -R "$host_user:$host_group" "$HOME"' EXIT

source /usr/local/lib/dirs.bash

sed -i "s|^Icon=.*|Icon=$QUARTUS_ICON|" /usr/local/share/applications/quartus.desktop

cp -f /usr/local/etc/uninstall "$HOME/uninstall"
cp -f /usr/local/etc/upgrade "$HOME/upgrade"
