# Quartus Installer is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU Lesser General Public License for more details.
#
# You should have received a copy of the GNU Lesser General Public License along with Quartus Installer. If not, see <https://www.gnu.org/licenses/>.

set -euo pipefail

source /usr/local/lib/dirs.bash

# Check if Quartus is installed
quartus_bin="$QUARTUS_DIR/quartus/bin/quartus"
if [[ ! -e "$quartus_bin" ]]; then
  notify-send --app-name "Quartus Launcher" "Quartus ist noch nicht installiert." \
    "Installiere es in der Konsole mit 'quartus-install'."
  exit 1
fi

# Setup shims
echo "Setting up shims..."

shim_dir="/usr/local/etc/quartus-shims"
while IFS= read -r -d '' shim_file; do
  echo ""
  echo "Setting up shim for $shim_file"

  relative_shim_file="$(realpath --relative-to="$shim_dir" "$shim_file")"
  quartus_file="$QUARTUS_DIR/$relative_shim_file"
  target_file="$(/usr/local/lib/shim/get-path "$quartus_file")"

  if [[ -L "$quartus_file" ]]; then
    echo "File is a symlink."

    symlink_target="$(readlink -f "$quartus_file")"
    if [[ "$symlink_target" == "$shim_file" ]]; then
      echo "File is already shimmed."

      continue
    fi

    ln -snf "$symlink_target" "$target_file"
  elif [[ ! -e "$quartus_file" ]]; then
    echo "File '$quartus_file' not found."
    continue
  else
    mv -f "$quartus_file" "$target_file"
  fi

  ln -snf "$shim_file" "$quartus_file"
done < <(find "$shim_dir" -type f -print0)

echo ""
echo "Done."

# Run actual program
export SALT_LICENSE_SERVER="$HOME/.altera.quartus/questa_lic.dat"
exec "$quartus_bin" --64bit "$@"
