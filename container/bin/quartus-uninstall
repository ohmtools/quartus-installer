set -euo pipefail

source /usr/local/lib/dirs.bash

echo "$CONTAINER_ID"
echo "$CONTAINER_HOME"

if [[ $(realpath "$CONTAINER_HOME") == $(realpath "$HOST_HOME") ]]; then
  echo "Die Deinstallation würde den HOME Ordner des aktuellen Benutzers löschen. Abgebrochen." >&2
  exit 1
fi

sudo find "$CONTAINER_HOME" -mindepth 2 -delete
