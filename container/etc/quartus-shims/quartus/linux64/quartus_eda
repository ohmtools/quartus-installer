set -euo pipefail

compare_arrays() {
  local -n a1=$1
  local -n a2=$2

  if [[ "${#a1[@]}" -ne "${#a2[@]}" ]]; then
    return 1
  fi

  for ((i = 0; i < ${#a1[@]}; i++)); do
    if [[ "${a1[i]}" != "${a2[i]}" ]]; then
      return 1
    fi
  done

  return 0
}

function exists_or() {
  local target=""

  if [[ -e "$1" ]]; then
    target="$1"
  else
    target="$2"
  fi

  echo "$target"
}

processed_args=()

args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  arg="${args[i]}"

  flag="${arg%%=*}"
  # Won't work if arg doesn't contain an =, but this is not relevant here.
  value="${arg#*=}"

  processed_arg=""

  case "$flag" in
  "--vector_source")
    processed_arg="$flag=$(exists_or "$value" "./$(basename "$value")")"
    ;;
  "--testbench_file")
    processed_arg="$flag=$(exists_or "$value" "./simulation/qsim/$(basename "$value").vt")"
    ;;
  "--output_directory")
    processed_arg="$flag=$(exists_or "$value" "./simulation/qsim/")"
    ;;
  *)
    processed_arg="$arg"
    ;;
  esac

  processed_args+=("$processed_arg")
done

if ! compare_arrays args processed_args; then
  echo "quartus_eda shim: Replaced arguments."
  echo "quartus_eda shim: Old arguments: ${args[*]}"
  echo "quartus_eda shim: New arguments: ${processed_args[*]}"
fi

exec /usr/local/lib/shim/call-target "$0" "${processed_args[@]}"
