set -euo pipefail

args=("$@")
len=${#args[@]}

project=""

for ((i = 0; i < len; i++)); do
  arg="${args[i]}"

  case "$arg" in
  --*=* | -*=*)
    ;;
  --* | -*)
    i=$((i + 1))
    ;;
  *)
    project="$arg"
    break
    ;;
  esac
done

function is_path_flag() {
  [[ "$1" =~ ^--(vector_source|testbench_file|output_directory)= ]]
}

if [[ -n $project ]]; then
  processed_args=()

  for arg in "${args[@]}"; do
    if is_path_flag "$arg"; then
      flag="${arg%%=*}"
      target="${arg#*=}"

      if [[ ! -e $target ]]; then
        # We don't know how many directories come after $project. So we cant use dirname or realpath
        relative_path="$(sed "s|.*/$project/|./|" <<<"$target")"

        echo "quartus_eda shim: Absolute $flag path to non-existent file detected. Replacing it with a relative path:"
        echo "quartus_eda shim: Old absolute path: $target"
        echo "quartus_eda shim: New relative path: $relative_path"
        echo ""

        arg="$flag=$relative_path"
      fi
    fi

    processed_args+=("$arg")
  done

  args=("${processed_args[@]}")
fi

exec /usr/local/lib/shim/call-target "$0" "${args[@]}"
