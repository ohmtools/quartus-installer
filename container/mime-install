#!/usr/bin/env bash
set -euo pipefail

VARS_LOCATION="$HOME/.local/share/quartus-prime-lite-ubuntu/.config/bdf-mime-vars"
[[ -f "$VARS_LOCATION" ]] && source "$VARS_LOCATION" || {
  echo "Stelle zuerst die installation mit quartus-install fertig."
  exit 1
}

MIME_FILE_DIR="$HOME/.local/share/mime/packages"
MIME_FILE_PATH="$MIME_FILE_DIR/quartus.xml"
mkdir -p "$MIME_FILE_DIR"
cp "$MIME_FILE" "$MIME_FILE_PATH"

MIME_ICON_DIR="$HOME/.local/share/icons/hicolor/64x64/mimetypes"
MIME_ICON_PATH="$MIME_ICON_DIR/application-x-quartus.png"
mkdir -p "$MIME_ICON_DIR"
cp "$ICON_FILE" "$MIME_ICON_PATH"

update-mime-database ~/.local/share/mime
gtk-update-icon-cache ~/.local/share/icons/hicolor -f 2>/dev/null
