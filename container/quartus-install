#!/usr/bin/env bash
set -euo pipefail

error_handler() {
  echo ""
  echo ""
  echo "------------------------------------------"
  echo "Ein Fehler ist aufgetreten."
  echo "------------------------------------------"
  echo ""
}

exit_handler() {
  echo ""
  echo ""
  echo "------------------------------------------"
  echo "Dieses Programm wurde beendet."
  echo "Du kannst es erneut ausführen, indem du"
  echo "quartus-install in das Terminal eingibst."
  echo "Evtl. musst du zuerst folgendes eingeben:"
  echo "distrobox enter quartus-prime-lite-ubuntu"
  echo "------------------------------------------"
  echo ""
}

trap error_handler ERR
trap exit_handler EXIT

cd "$HOME"

QUARTUS_CACHE="$HOME/.cache/quartus-prime-lite"
QUARTUS_SHARE="$HOME/.local/share/quartus-prime-lite"

mkdir -p "$QUARTUS_CACHE"
mkdir -p "$QUARTUS_SHARE"

echo ""
echo "------------------------------------------"
echo "INSTALLATIONSHILFE"
echo "------------------------------------------"
echo ""

INSTALLER_FILE="$HOME/.cache/quartus-prime-lite-installer"

SHOULD_DOWNLOAD="ja"
if [ -f "$INSTALLER_FILE" ]; then
  read -rp "Willst du die neuste Version des Quartus Prime Installers herunterladen (ja/nein)? " SHOULD_DOWNLOAD
  echo ""
fi

SHOULD_DOWNLOAD=$(echo "$SHOULD_DOWNLOAD" | tr '[:upper:]' '[:lower:]' | tr -d ' ')
if [ "$SHOULD_DOWNLOAD" = "ja" ]; then
  DOWNLOAD_LINK="https://www.altera.com/downloads/fpga-development-tools/quartus-prime-lite-edition-design-software-version-25-1-linux"
  xdg-open "$DOWNLOAD_LINK" 2>/dev/null &
  echo "Dein Browser hat sich geöffnet. Lade die neuste Version von 'Quartus Prime Installer (Recommended)' für Linux herunter."
  echo "Falls sich kein Browser öffnet, nutze diesen Link (Link mit STRG+SHIFT+C kopieren):"
  echo "$DOWNLOAD_LINK"
  read -rp "[ENTER] zum fortfahren..."
  echo ""

  echo "Wähle die heruntergeladene '.run' Datei aus."

  ZENITY_DIR="/"
  HOME_DIR="/"
  if [ -d "/home/$USER/Downloads/" ]; then
    ZENITY_DIR="/home/$USER/Downloads"
    HOME_DIR="/home/$USER"
  elif [ -d "/home/$USER/" ]; then
    ZENITY_DIR="/home/$USER"
    HOME_DIR="/home/$USER"
  fi

  cd "$HOME_DIR" 2>/dev/null || true

  DOWNLOADED_INSTALLER_PATH="$(zenity --file-selection --title="Installer wählen" --filename "$ZENITY_DIR/installer.run" --file-filter="*.run" 2>/dev/null)" || {
    echo "Keine Datei ausgewählt."
    exit 1
  }
  if [[ -z "$DOWNLOADED_INSTALLER_PATH" ]] || ! mv -- "$DOWNLOADED_INSTALLER_PATH" "$INSTALLER_FILE" 2>/dev/null; then
    echo "Fehler: Du hast keine valide Datei ausgewählt." >&2
    exit 1
  fi
  echo ""
fi

if [ ! -f "$INSTALLER_FILE" ]; then
  echo "Fehler: '$INSTALLER_FILE' wurde nicht gefunden. Skript wird beendet." >&2
  exit 1
fi

chmod +x "$INSTALLER_FILE"

INSTALLER=("$INSTALLER_FILE" --quiet --)

COMPONENT_LIST="$("${INSTALLER[@]}" --help | awk '/--components arg/{found=1} found{print; if(NF==0 || (found>1 && /^  --/)) exit; found++}' | head -n -1 | sed 's/^[[:space:]]*//' | tail -n +3)"

echo "Gib an, welche Komponenten Quartus du installieren willst."
echo "Verfügbare Komponenten:"
echo "$COMPONENT_LIST"
read -rp "Eingabe (Komma-Getrennt): " COMPONENTS
echo ""

if [ -z "$COMPONENTS" ]; then
  COMPONENTS="$(echo "$COMPONENT_LIST" | grep -E "^Default (components|devices):" | sed 's/Default [^:]*: //' | paste -sd ',')"
fi

COMPONENTS="${COMPONENTS// /}"

if [ -z "$COMPONENTS" ]; then
  echo "Fehler: Keine Komponenten ausgewählt oder gefunden." >&2
  echo "Originaler help output (--components Sektion ist relevant):"
  echo "$("${INSTALLER[@]}" --help)"
  exit 1
fi

"${INSTALLER[@]}" --bypass --cli --delete-downloads --accept-eula \
  --download-dir "$QUARTUS_CACHE" --install-dir "$QUARTUS_SHARE" \
  --components "$COMPONENTS"

distrobox-export --app quartus >/dev/null

echo ""
echo "------------------------------------------"
echo "FERTIG"
echo "Bitte schließe dieses Konsolenfenster."
echo "------------------------------------------"
echo ""
