#!/usr/bin/env bash
set -euo pipefail

DOWNLOAD_LINK="https://www.altera.com/downloads/fpga-development-tools/quartus-prime-lite-edition-design-software-version-25-1-linux"

error_handler() {
  notify-send --app-name "Quartus Prime Lite Installer" "Quartus Installation" "Es ist ein Fehler aufgetreten."

  echo ""
  echo ""
  echo "-------------------------------------------"
  echo "Ein Fehler ist aufgetreten."
  echo "-------------------------------------------"
  echo ""
}

exit_handler() {
  echo ""
  echo ""
  echo "-------------------------------------------"
  echo "Dieses Programm wurde beendet."
  echo "Du kannst es erneut starten, indem du"
  echo "'quartus-install' in das Terminal eingibst."
  echo "-------------------------------------------"
  echo ""
}

trap error_handler ERR
trap exit_handler EXIT

cd "$HOME"

QUARTUS_CACHE="$HOME/.cache/quartus-prime-lite"
QUARTUS_SHARE="$HOME/.local/share/quartus-prime-lite"

mkdir -p "$QUARTUS_CACHE"
mkdir -p "$QUARTUS_SHARE"

echo ""
echo "---------------------------------------------"
echo "INSTALLATIONSHILFE"
echo "---------------------------------------------"
echo ""

INSTALLER_FILE="$HOME/.cache/quartus-prime-lite-installer"

SHOULD_DOWNLOAD="0"
if [ -f "$INSTALLER_FILE" ]; then
  zenity --title "Installer herunterladen?" --question --text "Willst du den Quartus Installer nochmal herunterladen?" --default-cancel 2>/dev/null || {
    SHOULD_DOWNLOAD="1"
  }
fi

if [ "$SHOULD_DOWNLOAD" = "0" ]; then
  zenity --title "Altera Software Lizenzvereinbarung" --question --text "Akzeptierst du die Altera Software Lizenzvereinbarung ?" --default-cancel 2>/dev/null

  xdg-open "$DOWNLOAD_LINK" 2>/dev/null &

  CONTENT1='Dein Browser ist gestartet. Lade die neuste Version von <b>Quartus Prime Installer (Recommended)</b> herunter.'
  CONTENT2="$(printf '<a href="%s">Falls kein Browser startet, klicke hier.</a>' "$DOWNLOAD_LINK")"
  CONTENT3='Wenn du die Datei heruntergeladen hast, klicke auf <b>OK</b>'
  zenity --title "Installer herunterladen" --info --text "$CONTENT1\n\n$CONTENT2\n\n$CONTENT3" 2>/dev/null

  ZENITY_DIR="/"
  HOME_DIR="/"
  if [ -d "/home/$USER/Downloads/" ]; then
    ZENITY_DIR="/home/$USER/Downloads"
    HOME_DIR="/home/$USER"
  elif [ -d "/home/$USER/" ]; then
    ZENITY_DIR="/home/$USER"
    HOME_DIR="/home/$USER"
  fi

  cd "$HOME_DIR" 2>/dev/null || true

  DOWNLOADED_INSTALLER_PATH="$(zenity --title "Waehle die heruntergeladene '.run' Datei aus" --file-selection --filename "$ZENITY_DIR/installer.run" --file-filter="*.run" 2>/dev/null)" || {
    zenity --title "Fehler" --error --text "Keine Datei ausgewaehlt." 2>/dev/null
    exit 1
  }
  if [[ -z "$DOWNLOADED_INSTALLER_PATH" ]] || ! cp -f "$DOWNLOADED_INSTALLER_PATH" "$INSTALLER_FILE" 2>/dev/null; then
    zenity --title "Fehler" --error --text "Du hast keine valide Datei ausgewaehlt." 2>/dev/null
    exit 1
  fi
  echo ""
fi

if [ ! -f "$INSTALLER_FILE" ]; then
  zenity --title "Fehler" --error --text "'$INSTALLER_FILE' wurde nicht gefunden. Skript wird beendet." 2>/dev/null
  exit 1
fi

chmod +x "$INSTALLER_FILE"

echo "Bitte warten. Ein neues Pop-Up öffnet sich gleich."

INSTALLER=("$INSTALLER_FILE" --quiet --)

COMPONENT_LIST="$("${INSTALLER[@]}" --help | awk '/--components arg/{found=1} found{print; if(NF==0 || (found>1 && /^  --/)) exit; found++}' | head -n -1 | sed 's/^[[:space:]]*//' | tail -n +3)"

COMPONENTS="$(zenity --title "Komponenten auswaehlen" --entry --text "$COMPONENT_LIST\n\nEingabe (Komma-getrennt):" --entry-text "all" 2>/dev/null)" || {
  zenity --title "Fehler" --error --text "Keine Komponenten ausgewaehlt." 2>/dev/null
  exit 1
}

if [ -z "$COMPONENTS" ]; then
  COMPONENTS="$(echo "$COMPONENT_LIST" | grep -E "^Default (components|devices):" | sed 's/Default [^:]*: //' | paste -sd ',')"
fi

COMPONENTS="$(echo "$COMPONENTS" | tr -d ' ' | tr '[:upper:]' '[:lower:]')"

if [ -z "$COMPONENTS" ]; then
  zenity --title "Fehler" --error --text "Keine Komponenten ausgewaehlt oder gefunden.\n\nOriginaler help output (nur --components Sektion ist relevant):\n$("${INSTALLER[@]}" --help)" 2>/dev/null
  exit 1
fi

INSTALLATION_TEXT="Nach Bestaetigung startet die Installation.\nDas dauert eine Weile.\nVerfolge den Fortschritt in der Konsole."
zenity --title "Installation starten?" --question --text "$INSTALLATION_TEXT" 2>/dev/null

"${INSTALLER[@]}" --bypass --cli --delete-downloads --accept-eula \
  --download-dir "$QUARTUS_CACHE" --install-dir "$QUARTUS_SHARE" \
  --components "$COMPONENTS"

distrobox-export --app quartus >/dev/null

notify-send --app-name "Quartus Prime Lite Installer" "Quartus Installation" "Das Programm wurde erfolgreich installiert."
