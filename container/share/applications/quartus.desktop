[Desktop Entry]
Name=Quartus Prime Lite
Comment=FPGA Design Software
Exec=quartus-launch %f
Icon=quartus
Terminal=false
StartupNotify=true
Type=Application
Categories=Development;Electronics;
MimeType=application/x-quartus-qpf;application/x-quartus-vwf;
