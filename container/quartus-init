#!/usr/bin/env bash
set -euo pipefail

SHARE="$HOME/.local/share"

QUARTUS_DIR="$SHARE/quartus-prime-lite"
ICON_FILE="$QUARTUS_DIR/quartus/adm/quartusii.png"

DESKTOP_DIR="$SHARE/applications"
DESKTOP_FILE="$DESKTOP_DIR/quartus.desktop"
if [ ! -f "$DESKTOP_FILE" ]; then
  mkdir -p "$DESKTOP_DIR"
  cp /etc/quartus/quartus.desktop "$DESKTOP_FILE"
  sed -i "s|^Exec=.*|Exec=env SALT_LICENSE_SERVER=$HOME/.altera.quartus/questa_lic.dat $QUARTUS_DIR/quartus/bin/quartus --64bit %f|" "$DESKTOP_FILE"
  sed -i "s|^Icon=.*|Icon=$ICON_FILE|" "$DESKTOP_FILE"
fi

MIME_DIR="$SHARE/mime/packages"
MIME_FILE="$MIME_DIR/quartus.xml"
if [ ! -f "$MIME_FILE" ]; then
  mkdir -p "$MIME_DIR"
  cp /etc/quartus/quartus.xml "$MIME_FILE"
fi

MIME_VARS_DIR="$HOME/.config"
mkdir -p "$MIME_VARS_DIR"
printf 'export ICON_FILE=%s\nexport MIME_FILE=%s\n' "$ICON_FILE" "$MIME_FILE" >"$MIME_VARS_DIR/bdf-mime-vars"

UNINSTALL_FILE="$HOME/uninstall"
if [ ! -f "$UNINSTALL_FILE" ]; then
  cp /usr/local/bin/quartus-uninstall "$UNINSTALL_FILE"
fi

MIME_INSTALL_FILE="$HOME/mime-install"
if [ ! -f "$MIME_INSTALL_FILE" ]; then
  cp /usr/local/bin/quartus-mime-install "$MIME_INSTALL_FILE"
fi

DIR="$HOME"
OWNER=$(stat -c '%U' "$DIR")
GROUP=$(stat -c '%G' "$DIR")

chown -R "$OWNER:$GROUP" "$DIR"
