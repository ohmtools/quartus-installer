#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(realpath "$0")"

if [[ "$SCRIPT_PATH" != /tmp/* ]]; then
  TEMP_SCRIPT="$(mktemp /tmp/uninstall.XXXXXX.sh)"
  cp "$SCRIPT_PATH" "$TEMP_SCRIPT"
  chmod +x "$TEMP_SCRIPT"
  exec "$TEMP_SCRIPT" "$@"
fi

trap 'rm -f -- "$0"' EXIT

echo "Deinstalliere..."
echo ""

distrobox rm -f quartus-prime-lite-ubuntu 2>/dev/null || true

DISTROBOX_HOME_DIR="$HOME/.local/share/quartus-prime-lite-ubuntu"
[ -d "$DISTROBOX_HOME_DIR" ] && chmod -R +w "$DISTROBOX_HOME_DIR"
rm -rf ~/.local/share/mime/packages/quartus.xml ~/.local/share/icons/hicolor/64x64/mimetypes/application-x-quartus.png "$DISTROBOX_HOME_DIR"

update-mime-database ~/.local/share/mime || true
gtk-update-icon-cache ~/.local/share/icons/hicolor -f 2>/dev/null || true

echo ""
echo "Deinstallation abgeschlossen."
